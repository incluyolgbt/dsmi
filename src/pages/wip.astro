<html lang="es">
  <head>
    <title>Error 29434</title>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <script
      defer
      src="https://v2-dsmi-a.saludmental.lgbt/script.js"
      data-website-id="f3257efc-2124-49a1-84b6-d2e63d3ce890"
      data-performance="true"></script>
  </head>
  <body>
    <script>
      const FALLBACK_IP = "unavailable";
      const UMAMI_EVENT_NAME = "wip_ip_resolved";
      const UMAMI_TRACK_TIMEOUT_MS = 3000;

      const waitForUmami = () =>
        new Promise((resolve) => {
          if (window.umami?.track) {
            resolve(window.umami);
            return;
          }

          const startedAt = Date.now();
          const intervalId = window.setInterval(() => {
            if (window.umami?.track) {
              window.clearInterval(intervalId);
              resolve(window.umami);
              return;
            }

            if (Date.now() - startedAt >= UMAMI_TRACK_TIMEOUT_MS) {
              window.clearInterval(intervalId);
              resolve(undefined);
            }
          }, 100);
        });

      const trackIp = (ip) => {
        waitForUmami().then((umami) => {
          umami?.track?.(UMAMI_EVENT_NAME, { ip });
        });
      };

      {
        fetch("https://api.ipify.org?format=json")
          .then((response) => {
            if (!response.ok) {
              throw new Error("Unable to resolve public IP");
            }

            return response.json();
          })
          .then(({ ip }) => trackIp(ip || FALLBACK_IP))
          .catch(() => trackIp(FALLBACK_IP));
      }
    </script>
  </body>
</html>
